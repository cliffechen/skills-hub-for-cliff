# Reference only. Do not rename this file inside the skill and do not put real keys here.

# Windows User environment variable used by the Tavily MCP configuration.
TAVILY_API_KEY=REPLACE_WITH_TAVILY_API_KEY

# Sorftime is currently configured in the MCP URL query string, not read by the skill.
SORFTIME_API_KEY=REPLACE_WITH_SORFTIME_API_KEY

# Preferred Google Trends collector. Read by scripts/fetch_serpapi_google_trends.py.
SERPAPI_KEY=REPLACE_WITH_SERPAPI_KEY

# Optional Feishu Bitable delivery. Put these in assets/feishu-mcp/.env after copying
# that connector to a stable folder outside the installed skill.
FEISHU_APP_ID=REPLACE_WITH_FEISHU_APP_ID
FEISHU_APP_SECRET=REPLACE_WITH_FEISHU_APP_SECRET
